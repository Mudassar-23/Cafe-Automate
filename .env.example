# ── Cafe Automate — environment template ───────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# JWT signing secret — use a long random string in production
Jwt__Secret=change_me_to_something_long_and_random

# Website Admin seed account (created once on first startup)
Seed__WebsiteAdmin__FullName=Website Admin
Seed__WebsiteAdmin__Email=admin@yourdomain.com
Seed__WebsiteAdmin__Password=change_me

# Cafe Admin seed account
Seed__CafeAdmin__FullName=Cafe Admin
Seed__CafeAdmin__Email=cafeadmin@yourdomain.com
Seed__CafeAdmin__Password=change_me

# ── Database ────────────────────────────────────────────────────
# PostgreSQL (production) — if connection fails, falls back to SQLite.
# Percent-encode any special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/CAFEAuto

# SQLite fallback (auto-used if PostgreSQL is unavailable).
# Path is relative to the CafeAutomate.Api folder. Avoid ./data — on Windows
# that collides with the Data/ source folder.
DATABASE_FALLBACK_URL=sqlite:///./App_Data/cafe.db

# PostgreSQL password — used by the docker-compose db service
POSTGRES_PASSWORD=change_me
